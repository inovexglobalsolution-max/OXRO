PORT=5000
NODE_ENV=development

# Supabase (backend-only — real values live in .env, never commit them)
SUPABASE_URL=<paste-supabase-url>
SUPABASE_PUBLISHABLE_KEY=<paste-publishable-key>
SUPABASE_SECRET_KEY=<paste-sb_secret-key>
SUPABASE_ACCESS_TOKEN=<paste-sbp-access-token>

JWT_SECRET=<paste-random-secret>
BASE_URL=<paste-backend-base-url>

# Brevo SMTP for Supabase Auth emails (backend/Management API only)
BREVO_SMTP_USER=<brevo-login-email>
BREVO_SMTP_KEY=<brevo-smtp-key>
BREVO_FROM=<verified-sender@your-domain.com>
BREVO_FROM_NAME=OXRO

# Resend SMTP for Supabase Auth emails (backend/Management API only)
RESEND_API_KEY=<re_xxx>
RESEND_FROM=OXRO <onboarding@resend.dev>
# After oxro.in is Verified in Resend: RESEND_FROM=OXRO <info@oxro.in>
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
RESEND_SMTP_USER=resend

# Google sign-in (backend verification of the ID token's audience)
GOOGLE_SERVER_CLIENT_ID=<paste-google-web-client-id>
